background = #292C34
foreground = #C7C2AE
cursor-color = #C7C2AE

font-family = "MonoLisa"
font-size = 14

macos-titlebar-style = tabs

keybind = cmd+shift+[=previous_tab
keybind = cmd+shift+]=next_tab
keybind = cmd+[=goto_split:next
keybind = cmd+]=goto_split:previous
keybind = ctrl+tab=text:\x1b[9;5u
