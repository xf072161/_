{
  "theme": {
    "mode": "dark",
    "light": "clarity light",
    "dark": "clarity dark",
  },
  "disable_ai": true,
  "vim_mode": true,
  "cursor_blink": false,
  "tab_size": 2,
  "ui_font_family": "MonoLisa",
  "ui_font_size": 14,
  "buffer_font_family": "MonoLisa",
  "buffer_font_size": 14,
  "show_whitespaces": "none",
  "languages": {
    "Go": {
      "tab_size": 4,
    },
  },
  "lsp": {
    "gopls": {
      "initialization_options": {
        "usePlaceholders": true,
        "staticcheck": true,
        "analyses": {
          "unusedparams": true,
          "ST1000": false,
        },
        "codelenses": {
          "test": true,
        },
        "buildFlags": ["-tags=acceptance,functional"],
      },
    },
  },
  "diagnostics": {
    "inline": { "enabled": true },
  },
  "project_panel": {
    "dock": "left",
    "indent_guides": { "show": "never" },
    "scrollbar": { "show": "never" },
  },
  "title_bar": {
    "show_sign_in": false,
    "show_user_menu": false,
  },
  "status_bar": { "experimental.show": false },
  "toolbar": { "quick_actions": false },
  "tab_bar": { "show": false },
  "indent_guides": { "enabled": false },
  "buffer_font_features": { "liga": false },
  "vim": { "use_system_clipboard": "never" },
}
